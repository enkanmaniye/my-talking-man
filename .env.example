# Copy to .env.local. Never commit real values.
# Stage 0 reads none of these; they are listed so later stages have one home.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser: never put a secret in one.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Stage 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# Avatar generation (Stage 4; the provider needs your approval first)
AVATAR_PROVIDER=
AVATAR_BASE_URL=
# Server only.
AVATAR_API_KEY=

# AI provider (Stage 5; the provider needs your approval first)
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Server only.
AI_API_KEY=

# AI cost limits (Stage 5). The daily limit is shown to users.
AI_MAX_OUTPUT_TOKENS=400
AI_RECENT_MESSAGE_WINDOW=20
AI_DAILY_MESSAGE_LIMIT=100
